rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Hilfsfunktionen
    // ============================================

    // Prüft ob der Benutzer eingeloggt ist
    function isSignedIn() {
      return request.auth != null;
    }

    // Prüft ob der Benutzer der Besitzer ist
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Erlaubte Schul-Domains. Muss mit ERLAUBTE_EMAIL_DOMAINS in lehrer-dashboard.html
    // übereinstimmen. Weitere Domain ergänzen: '.*@(belose[.]ch|andere-schule[.]ch)$'
    function hatSchulAdresse() {
      return request.auth.token.email.lower().matches('.*@(belose[.]ch)$');
    }

    // Lehrperson = eingeloggt + E-Mail bestätigt + Schul-Adresse.
    // Die Bestätigung ist nötig, weil Firebase bei der Registrierung nicht prüft,
    // ob jemand die Adresse wirklich besitzt.
    function istLehrperson() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && hatSchulAdresse();
    }

    // ============================================
    // Collections
    // ============================================

    // Termine: öffentlich lesbar (Eltern-Formular), schreiben nur die eigene Lehrperson
    match /termine/{terminId} {
      allow read: if true;
      allow create: if istLehrperson()
        && request.resource.data.user_id == request.auth.uid;
      allow update: if istLehrperson()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if istLehrperson()
        && resource.data.user_id == request.auth.uid;
    }

    // Antworten: Eltern erstellen ohne Login; lesen/ändern/löschen nur die
    // Lehrperson, an die die Antwort gerichtet ist (termin_gruppe_id).
    match /antworten/{antwortId} {
      allow create: if gueltigeNeueAntwort();
      allow read, delete: if istLehrperson()
        && resource.data.termin_gruppe_id == request.auth.uid;
      // Zusammenführen/Trennen ändert den Namen - die Zuordnung zur Lehrperson bleibt fix
      allow update: if istLehrperson()
        && resource.data.termin_gruppe_id == request.auth.uid
        && request.resource.data.termin_gruppe_id == resource.data.termin_gruppe_id;
    }

    // Felder exakt wie in eltern-formular.html -> submitForm()
    function gueltigeNeueAntwort() {
      let d = request.resource.data;
      return d.keys().hasOnly(['termin_gruppe_id', 'kindname_encrypted', 'kindname_hash',
                               'email_encrypted', 'verfuegbare_termine', 'created_at'])
        && d.termin_gruppe_id is string
        // Antwort nur an existierende Lehrpersonen (Schlüssel wird beim ersten Login erzeugt)
        && exists(/databases/$(database)/documents/encryption_keys/$(d.termin_gruppe_id))
        && d.kindname_encrypted is string && d.kindname_encrypted.size() <= 2000
        && d.kindname_hash is string && d.kindname_hash.size() <= 100
        && d.email_encrypted is string && d.email_encrypted.size() <= 2000
        && d.verfuegbare_termine is list && d.verfuegbare_termine.size() <= 200
        && d.created_at == request.time;
    }

    // Zuteilungen: öffentlich lesbar (Formular prüft, ob ein Termin frei ist;
    // enthält nur IDs), schreiben nur die eigene Lehrperson (user_id).
    match /zuteilungen/{zuteilungId} {
      allow read: if true;
      allow create: if istLehrperson()
        && request.resource.data.user_id == request.auth.uid;
      allow update: if istLehrperson()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      // Übergangsregel: Zuteilungen von vor 2026-10 haben kein user_id-Feld und
      // dürfen von jeder Lehrperson gelöscht werden (das Dashboard löscht nur eigene).
      allow delete: if istLehrperson()
        && (!('user_id' in resource.data) || resource.data.user_id == request.auth.uid);
    }

    // Settings: öffentlich lesbar (Formular zeigt Name/Mindestanzahl),
    // schreiben nur der Besitzer. Ohne Bestätigung erlaubt, damit die
    // Registrierung die Settings anlegen kann.
    match /settings/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Encryption Keys: öffentlich lesbar (Formular verschlüsselt damit).
    // Nur einmalig anlegen - ein überschriebener Schlüssel würde alle
    // bisherigen Antworten unlesbar machen.
    match /encryption_keys/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }

    // Mail-Queue für die "Trigger Email" Extension (liest/schreibt mit Admin-Rechten).
    // Lehrpersonen sehen nur ihre eigenen Mails (für die Limit-Anzeige im Dashboard)
    // und dürfen keinen eigenen Absender setzen (SPF/DKIM, Schutz vor Missbrauch).
    match /mail/{mailId} {
      allow read: if istLehrperson()
        && resource.data._meta.lehrer_uid == request.auth.uid;
      allow create: if istLehrperson()
        && request.resource.data._meta.lehrer_uid == request.auth.uid
        && !('from' in request.resource.data);
      allow update, delete: if false;
    }
  }
}
